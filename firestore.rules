rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Supreme Admin Check
    function isSupremeAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'zulora.help@gmail.com' || 
         (request.auth.token.email_verified == true && request.auth.token.email == 'zulora.help@gmail.com'));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isSupremeAdmin());
    }

    // Shops Collection
    match /shops/{shopId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource.data.ownerUid == request.auth.uid || 
         resource.data.sellerUid == request.auth.uid || 
         shopId == request.auth.uid || 
         isSupremeAdmin());
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow updates by merchant/admin, or inventory stock decrement upon order placement
      allow update: if (request.auth != null && 
        (resource.data.ownerUid == request.auth.uid || 
         resource.data.sellerUid == request.auth.uid || 
         resource.data.shopId == request.auth.uid || 
         isSupremeAdmin())) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'salesCount', 'inStock']));
      // Strict deletion: Only product owners (ownerUid/sellerUid/shopId) or Supreme Admin
      allow delete: if request.auth != null && 
        (resource.data.ownerUid == request.auth.uid || 
         resource.data.sellerUid == request.auth.uid || 
         resource.data.shopId == request.auth.uid || 
         isSupremeAdmin());
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true; // Enables guest COD + signed-in buyer checkout
      // Allow merchant confirmation, status progression, or buyer delivery verification
      allow update: if true;
      // Orders can be deleted by merchant or Supreme Admin
      allow delete: if request.auth != null && 
        (resource.data.sellerUid == request.auth.uid || 
         resource.data.shopId == request.auth.uid || 
         isSupremeAdmin());
    }
  }
}
